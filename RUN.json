{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": ".",
      "stack": "python",
      "kind": "server",
      "install": [["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {"path": "/health", "expect_status": [200]},
      "test": [["${python}", "-m", "pytest", "-q"]],
      "env": {
        "LIBRARY_API_KEY": {"generate": "hex", "bytes": 32},
        "LIBRARY_DB_PATH": {"dev": "library.db"}
      }
    }
  ]
}
